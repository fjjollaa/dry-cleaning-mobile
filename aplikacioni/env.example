# Kopjoje këtë skedar si .env.local dhe plotësoji vlerat. .env.local NUK ngarkohet kurrë në GitHub.

# Neon (Vercel -> Storage -> Neon, ose console.neon.tech). Përdor databazë të veçantë për këtë projekt.
DATABASE_URL=

# Google (hyrja për klientët): console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opsionale, vetëm për prova gjatë zhvillimit (mos e vendos në publikim). OAuth App në GitHub:
# Callback http://localhost:3000/api/auth/callback/github
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# Një varg i gjatë i rastësishëm, p.sh. nga: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
